{
  "expo": {
    "name": "Chitti",
    "slug": "chitti",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "chitti",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chitti to choose profile and payment proof photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.chitti.family",
      "icon": "./assets/icon.png"
    },
    "ios": {
      "bundleIdentifier": "com.chitti.family",
      "icon": "./assets/icon.png",
      "supportsTablet": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78993490-b887-49b3-a97e-e094eefee165"
      }
    }
  }
}
